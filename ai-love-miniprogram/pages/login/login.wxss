/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF3E0 0%, #FFE4E1 100%);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Logo 区域 */
.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B8A;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 登录卡片 */
.login-section {
  width: 100%;
  padding: 40rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 138, 0.2);
}

.welcome-text {
  text-align: center;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 40rpx;
}

/* 身份选择区域 */
.identity-section {
  margin-bottom: 32rpx;
}

.section-title {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.identity-options {
  display: flex;
  gap: 24rpx;
}

.identity-option {
  flex: 1;
  padding: 32rpx 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.identity-option.active {
  background: linear-gradient(135deg, #FF6B8A 0%, #FF8FA3 100%);
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.3);
}

.identity-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.identity-name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.identity-option.active .identity-name {
  color: white;
}

/* 提示区域 */
.tip-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 登录按钮 */
.login-btn {
  background: linear-gradient(135deg, #FF6B8A 0%, #FF8FA3 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 32rpx;
  padding: 24rpx;
  border: none;
}

.login-btn[disabled] {
  background: #ccc;
  opacity: 0.6;
}
